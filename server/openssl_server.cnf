# openssl_server.cnf -- TLS server certificate, issued by the INTERMEDIATE.
#
# Used by bin/create_server.sh: req (the subject of the CSR) and
# ca ... -extensions server. CA_default is the intermediate's: it points at
# the intermediate's database and key. Validity is set by the script (DAYS).

.include ./common_policy.cnf

[ca]
default_ca                      = CA_default

[ CA_default ]
dir                             = intermediate
new_certs_dir                   = $dir/newcerts
database                        = $dir/index.txt
# serial                          = $dir/serial
rand_serial                     = yes
private_key                     = $dir/private/$dir.key.pem
certificate                     = $dir/certs/$dir.cert.pem

# SHA-1 is deprecated, so use SHA-2 instead.
default_md                      = sha256

name_opt                        = ca_default
cert_opt                        = ca_default
preserve                        = no
policy                          = policy_loose

# allow issuing multiple certificates with the same CN
unique_subject                  = no

[req]
# Options for the `req` tool (`man req`).
distinguished_name                = req_distinguished_name
string_mask                       = utf8only

[ req_distinguished_name ]
# See <https://en.wikipedia.org/wiki/Certificate_signing_request>.
countryName                     = $ENV::ORG_COUNTRY
stateOrProvinceName             = $ENV::ORG_STATE
localityName                    = $ENV::ORG_LOCALITY
organizationName                = $ENV::ORG_NAME
organizationalUnitName          = $ENV::ORG_NAME Server Certificate
commonName                      = $ENV::SERVER_FQDN

# Optionally, specify some defaults.
countryName_default             = $ENV::ORG_COUNTRY
stateOrProvinceName_default     = $ENV::ORG_STATE
localityName_default            = $ENV::ORG_LOCALITY
organizationName_default        = $ENV::ORG_NAME
organizationalUnitName_default  = $ENV::ORG_NAME Server Certificate
commonName_default              = $ENV::SERVER_FQDN

[ server ]
# Extensions for server certificates (`man x509v3_config`).
basicConstraints                = CA:FALSE
subjectKeyIdentifier            = hash
authorityKeyIdentifier          = keyid:always
keyUsage                        = critical, digitalSignature
extendedKeyUsage                = serverAuth
subjectAltName                  = DNS:$ENV::SERVER_FQDN
crlDistributionPoints           = URI:http://$ENV::PKI_FQDN/intermediate.crl
authorityInfoAccess     = caIssuers;URI:http://$ENV::PKI_FQDN/intermediate.cer
