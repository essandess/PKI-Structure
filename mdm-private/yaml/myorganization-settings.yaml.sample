# Source description for: Settings for iOS (passcode, Wi-Fi, restrictions)
#
# The converter fills in: PayloadType (Configuration), PayloadVersion, PayloadUUIDs,
# payload identifiers (<profile identifier>.<id>), and PayloadEnabled defaults.
#
# CONTAINS SECRETS (Wi-Fi password). Keep this file under mdm-private/, mode 0600.
# The generated .mobileconfig holds the password as readable text; signing does not
# encrypt it.

# ---- Profile ---------------------------------------------------------------
# identifier: org.myorganization.mdm.myorganization-settings
#   Optional. Default: <DOMAIN_NAME from identity.env, reversed>.mdm.<this file's name>.
#   Keep it stable once deployed: devices match profiles on it.
name: Settings for iOS
description: Passcode, Wi-Fi and restriction policy for MyOrganization devices.
organization: ${ORG_NAME}        # from identity.env
scope: System                    # optional; System (default) or User
removal_disallowed: false        # optional; PayloadRemovalDisallowed, default false

# Optional layers merged UNDER this file, in order (later files and this file win).
# Paths are relative to this file. Included files may contain only `payloads:`.
include:
  - ios-restrictions-baseline.yaml   # pins Apple's default restriction values; delete to skip

# ---- Payloads --------------------------------------------------------------
# id        Required. Stable slug, unique in the profile. Payload identifier becomes
#           <profile identifier>.<id>; the UUID is derived from it. Also the merge key
#           for `include:` layers. Do not rename after deployment.
# type      Required. Apple payload type, verbatim.
# name      Optional. PayloadDisplayName (default: the id).
# description  Optional. PayloadDescription.
# settings  Apple's own key names and value types, passed through unchanged.
#           Keys starting with "Payload" are reserved for the converter.
#           Quote strings that YAML would read as numbers or booleans ("12345678", "yes").
payloads:

  - id: passcode
    type: com.apple.mobiledevice.passwordpolicy
    name: Passcode
    description: Configures passcode settings
    settings:
      forcePIN: true
      allowSimple: true
      minLength: 7
      requireAlphanumeric: false
      maxFailedAttempts: 10
      maxInactivity: 2

  - id: wifi-myssid
    type: com.apple.wifi.managed
    name: WiFi (My SSID WiFi Name)
    settings:
      SSID_STR: My SSID WiFi Name
      Password: "CHANGE-ME"            # secret
      EncryptionType: WPA
      AutoJoin: true
      HIDDEN_NETWORK: false
      CaptiveBypass: false
      IsHotspot: false
      ProxyType: Auto
      ProxyPACURL: http://proxy.myorganization.private/proxy.pac
      ProxyPACFallbackAllowed: true
      # Not carried over from Profile Manager output: AuthenticationMethod "" (empty),
      # Interface BuiltInWireless, SetupModes [] (legacy/empty) and PayloadEnabled true (default).

  # Only the departures from Apple's defaults. The defaults themselves come from the
  # baseline file above, merged key by key.
  - id: restrictions
    type: com.apple.applicationaccess
    name: Restrictions
    settings:
      # Privacy
      allowApplePersonalizedAdvertising: false
      forceLimitAdTracking: true
      allowDiagnosticSubmission: false
      allowDiagnosticSubmissionModification: false
      # Managed / unmanaged contacts separation
      allowManagedToWriteUnmanagedContacts: false
      allowUnmanagedToReadManagedContacts: false
      # Apple Watch
      forceWatchWristDetection: true
