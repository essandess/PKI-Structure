#!/usr/bin/env bash

# create_organization_smime_pki.sh

set -e
set -E
set -o pipefail
trap 'rc=$?; echo "Error: $(basename "$0") failed (exit ${rc}) at ${BASH_SOURCE[0]}:${LINENO}: ${BASH_COMMAND}" >&2' ERR

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PKI_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "${PKI_ROOT}" || exit

# S/MIME certificate creation

# Person A
bin/create_smime.sh person_a@gmail.com persona_gmail_2026
bin/create_smime.sh person_a@icloud.com persona_icloud_2026
bin/create_smime.sh person_a@school.edu persona_school_2026
bin/create_smime.sh person_a@myorganization.org persona_myorganization_2026

# Person B
bin/create_smime.sh person_b@gmail.com personb_gmail_2026
bin/create_smime.sh person_b@icloud.com personb_icloud_2026
bin/create_smime.sh person_b@myorganization.org personb_myorganization_2026
