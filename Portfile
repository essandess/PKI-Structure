set pki_etc_dir_str {${prefix}/etc/pki-structure}
set pki_etc_dir     [subst ${pki_etc_dir_str}]
set pki_log_dir_str {${prefix}/var/log/pki-structure}
set pki_log_dir     [subst ${pki_log_dir_str}]
