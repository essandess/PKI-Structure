# ios-configurator-extras.yaml
#
# Example fragment for the Apple Configurator.app payload categories that have no
# dedicated top-level YAML section (unlike certificates:/identities:/accounts:, which
# need Python for certificate parsing, revocation checks, or friendly-field translation).
# Every payload below is the generic 'payloads:' mechanism from bin/configurate_yaml.py:
# Apple's own key names under 'settings:', a short 'type:' from TYPE_ALIASES, and a file
# embedded with {file: path} where a payload needs binary data. No new Python is needed to
# add another payload like these -- see the module docstring in bin/configurate_yaml.py.
#
# Unverified: no reference .mobileconfig exists for these six payload types
# (Passcode, Wi-Fi, Restrictions and accounts came from a Configurator export).
#   AirPrint, Fonts, Web Clip: keys from Apple's Device Management docs.
#   Notifications, Content Filter (BuiltIn): supervised devices only (verify).
#   AirPlay, Subscribed Calendars: key names unknown; placeholders only.
# Build with --no-sign, install on ONE test device, confirm the effect first.

name: iOS Configurator Extras (example)
description: Example fragment -- verify before use, see header.
payloads:

  # ---- AirPrint: restrict to specific known printers ------------------------------
  - id: airprint
    type: airprint                       # -> com.apple.airprint
    name: AirPrint
    settings:
      AirPrint:
        - IPAddress: 10.0.1.50
          ResourcePath: /printers/lobby  # optional; default is usually fine to omit
          # Port: 631                    # optional; 631 is the default

  # ---- Fonts: install a custom font file -------------------------------------------
  - id: corporate-font
    type: fonts                          # -> com.apple.font
    name: Corporate Font
    settings:
      Name: MyOrgSans-Regular            # the font's own internal name, not a label
      Font: {file: $PKI_ROOT/assets/fonts/MyOrgSans-Regular.ttf}

  # ---- Web Clip: a home-screen icon that opens a URL --------------------------------
  - id: intranet-webclip
    type: webclip                        # -> com.apple.webClip.managed
    name: Intranet
    settings:
      Label: Intranet
      URL: https://intranet.myorganization.org
      Icon: {file: $PKI_ROOT/assets/icons/intranet-clip.png}   # 1024x1024 recommended
      IsRemovable: true
      FullScreen: false
      Precomposed: false

  # ---- Notifications: supervised only (verify) ----
  - id: notifications
    type: notifications                  # -> com.apple.notificationsettings
    name: Notifications
    settings:
      NotificationSettings:
        - BundleIdentifier: com.myorganization.corpapp
          NotificationsEnabled: true
          ShowInNotificationCenter: true
          ShowInLockScreen: false
          BadgesEnabled: true
          SoundsEnabled: true
          AlertType: 2                   # 0 = None, 1 = Banner, 2 = Alerts (unverified numbering)

  # ---- Content Filter, BuiltIn: supervised only (verify) ----
  # The Plugin/vendor-specific variant has many more keys (ServerAddress, credentials,
  # PluginBundleID, ...) not attempted here.
  - id: content-filter
    type: content-filter                 # -> com.apple.webcontent-filter
    name: Content Filter
    settings:
      FilterType: BuiltIn
      AutoFilterEnabled: true
      PermittedURLs:
        - https://intranet.myorganization.org
      BlacklistedURLs: []

  # ---- AirPlay: NOT verified -- placeholder only, fill in after checking Apple's docs
  # - id: airplay
  #   type: airplay                      # -> com.apple.airplay
  #   name: AirPlay
  #   settings:
  #     {}                               # unknown key names; see CONFIDENCE note above

  # ---- Subscribed Calendars: NOT verified -- placeholder only -----------------------
  # - id: team-calendar
  #   type: subscribed-calendar          # -> com.apple.subscribedcalendar
  #   name: Team Calendar
  #   settings:
  #     {}                               # unknown key names; see CONFIDENCE note above
