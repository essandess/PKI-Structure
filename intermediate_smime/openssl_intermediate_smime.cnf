# openssl_intermediate_smime.cnf -- configuration of the S/MIME INTERMEDIATE CA.
#
# Used by
#   bin/create_intermediate_smime.sh  req (the subject of the CSR); this is
#                               create_intermediate.sh with
#                               CERTDIR=intermediate_smime
#   bin/create_crl.sh intermediate_smime,
#   bin/revoke_certificate.sh intermediate_smime,
#   bin/updatedb_and_delete_expired_certs.sh
#   bin/create_smime.sh         ca -revoke, through pki_revoke_matching_cn
# The certificate itself is issued by the ROOT, with the intermediate_smime_ca
# section below (create_intermediate.sh passes this file as -extfile).
# Certificates this CA issues use smime/openssl_smime.cnf, which points at this
# CA's database.
#
# Scope: extendedKeyUsage = emailProtection. A chain through this CA is
# therefore not valid for TLS servers or code signing. There are no
# nameConstraints because S/MIME addresses span unrelated domains.
# The TLS server and code signing certificates come from ../intermediate,
# which is the one restricted by nameConstraints.

.include ./common_policy.cnf

[ca]
default_ca                      = CA_default

[ CA_default ]
dir                             = intermediate_smime
new_certs_dir                   = $dir/newcerts
rand_serial                     = yes
database                        = $dir/index.txt
private_key                     = $dir/private/intermediate_smime.key.pem
certificate                     = $dir/certs/intermediate_smime.cert.pem

# For certificate revocation lists.
crlnumber                       = $dir/crlnumber
crl_extensions                  = crl_ext
default_crl_days                = 30

# SHA-1 is deprecated, so use SHA-2 instead.
default_md                      = sha256

name_opt                        = ca_default
cert_opt                        = ca_default
preserve                        = no
policy                          = policy_loose

# allow issuing multiple certificates with the same CN
unique_subject                  = no

[req]
# Options for the `req` tool (`man req`).
distinguished_name              = req_distinguished_name
string_mask                     = utf8only

[ req_distinguished_name ]
# See <https://en.wikipedia.org/wiki/Certificate_signing_request>.
# The root signs with policy_strict: country, state, locality and
# organization must match the root's.
countryName                     = $ENV::ORG_COUNTRY
stateOrProvinceName             = $ENV::ORG_STATE
localityName                    = $ENV::ORG_LOCALITY
organizationName                = $ENV::ORG_NAME
organizationalUnitName          = $ENV::ORG_NAME Intermediate S/MIME Certification Authority
commonName                      = $ENV::ORG_NAME Intermediate S/MIME CA

# Optionally, specify some defaults.
countryName_default             = $ENV::ORG_COUNTRY
stateOrProvinceName_default     = $ENV::ORG_STATE
localityName_default            = $ENV::ORG_LOCALITY
organizationName_default        = $ENV::ORG_NAME
organizationalUnitName_default  = $ENV::ORG_NAME Intermediate S/MIME Certification Authority
commonName_default              = $ENV::ORG_NAME Intermediate S/MIME CA

# Extensions of this CA's own certificate; the root signs with them (-extfile).
[ intermediate_smime_ca ]
# The S/MIME intermediate certificate, issued by the root.
subjectKeyIdentifier            = hash
authorityKeyIdentifier          = keyid:always
basicConstraints                = critical, CA:true, pathlen:0
keyUsage                        = critical, cRLSign, keyCertSign
extendedKeyUsage                = emailProtection
crlDistributionPoints           = URI:http://$ENV::PKI_FQDN/root.crl
authorityInfoAccess             = caIssuers;URI:http://$ENV::PKI_FQDN/root.cer

[ crl_ext ]
# Extension for CRLs (`man x509v3_config`).
authorityKeyIdentifier          = keyid:always
