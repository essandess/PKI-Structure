#
# Default PF configuration file.
#
# This file contains the main ruleset, which gets automatically loaded
# at startup.  PF will not be automatically enabled, however.  Instead,
# each component which utilizes PF is responsible for enabling and disabling
# PF via -E and -X as documented in pfctl(8).  That will ensure that PF
# is disabled only when the last enable reference is released.
#
# Care must be taken to ensure that the main ruleset does not get flushed,
# as the nested anchors rely on the anchor point defined here. In addition,
# to the anchors loaded by this file, some system services would dynamically 
# insert anchors into the main ruleset. These anchors will be added only when
# the system service is used and would removed on termination of the service.
#
# See pf.conf(5) for syntax.
#

# References for modifications:
# The Book of PF by Peter N.M. Hansteen, p. 21
# http://ikawnoclast.com/security/mac-os-x-pf-firewall-avoiding-known-bad-guys/
# http://support.apple.com/kb/HT5519?viewlocale=en_US&locale=en_US
# http://blog.scottlowe.org/2013/05/15/using-pf-on-os-x-mountain-lion/
# http://krypted.com/mac-security/a-cheat-sheet-for-using-pf-in-os-x-lion-and-up/


# Internal interface; use the command `ifconfig -a` or:
# $ ifconfig | pcregrep -M -o '^[^\t:]+:([^\n]|\n\t)*status: active' | egrep -o -m 1 '^[^\t:]+'
int_if = "en0"

# VPN tunnels
# sudo pfctl -s Interfaces -v | grep utun
# use a group because specific utun numbers aren't stable across interfaces
tun_if = "{ utun0, utun1, utun2, utun3, utun4, utun5, utun6, utun7, utun8, utun9, utun10, utun11, utun12, utun13, utun14, utun15, utun16, utun17, utun18, utun19 }"


# Macros and Tables

# Hardcoded IPs
myorganization_org = "<my ip address>"
my_other_organization_org = "<my org ip address>"

lan_tcp_services = "{ domain, kerberos, microsoft-ds, eyetv, 3128, \
        net-assistant, 5001, 5900:5909, privoxy, 8119, 8123, 8180 }"
lan_udp_services = "{ domain, net-assistant, 5001 }"

# https://support.apple.com/en-us/HT202944
internet_tcp_services = "{ 9030, 49160:49163 }"
internet_udp_services = "{ https, isakmp, l2f, ipsec-msft, 16384:16403 }"

# Mail ports
mail_tcp_services = "{ smtp, imap, submission, imaps, cert-responder, sieve }"
# CalDAV/CardDAV + web ports
calendar_web_tcp_services = "{ https, 8008, 8443, 8800, 8843 }"

# webmailcalcard_tcp_services = "{ smtp, www, imap, https, submission, imaps, \
# 	cert-responder, sieve, 8008, 8443, 8800, 8843 }" 

syncthing_service = "22000"

table <lan_inet6> const { ::1, fe80::/10 }
table <whitelist> const { $myorganization_org $my_other_organization_org }
table <bruteforce> persist
table <httpflood> persist


# VPN *server* network -- all #vpn# lines are rules for a VPN server, not a VPN client
# $vpn_net == utun0/24 when Tunnelblick creates utun0
#vpnserver# vpn_net = "10.8.0/24"	# utun0 interface doesn't exist at boot time
#vpnserver# vpn_net6 = "fd00:3550:faeb::/64"
#vpnserver# tun_if = "utun4"


# Options
set block-policy return
set fingerprints "/etc/pf.os"
set ruleset-optimization basic
set skip on lo0

 
# Normalization
# Scrub incoming packets
# Disable: slows down large packets
#scrub in all no-df

# consistent with config.ovpn
#vpnserver# scrub on $tun_if all fragment reassemble max-mss 1400
 
#
# com.apple anchor point
#
scrub-anchor "com.apple/*"


# Queueing
 

# Translation

# OpenVPN Server NAT
# 
# The Book of PF, p. 21
# Allow VPN connections to the VPN host:
# http://serverfault.com/questions/555594/troubleshoot-broken-tcp-from-openvpn-client-to-server-but-ping-traceroute-work
# $ sudo vi /etc/sysctl.conf
# net.inet.ip.forwarding=1
# # net.inet6.ip6.forwarding=1
#vpnserver# no nat on $int_if inet from $vpn_net to ($int_if)
#vpnserver# nat on $int_if inet from $vpn_net to ! ($int_if:network) -> ($int_if)

nat-anchor "com.apple/*"
rdr-anchor "com.apple/*"
dummynet-anchor "com.apple/*"
anchor "com.apple/*"
load anchor "com.apple" from "/etc/pf.anchors/com.apple"

# macOS Server Adaptive Firewall
# Comment out for non-macOS Server instances
# anchor "com.apple.server-firewall/*"
# load anchor "com.apple.server-firewall" from "/etc/pf.anchors/com.apple.server-firewall"

# Filtering

# Block by default
block all

# Debugging:
# pass quick log (all, to pflog0) all
# block log (all, to pflog0) all

# debugging rules
# $ sudo ifconfig pflog0 create 
# $ sudo tcpdump -n -e -ttt -i pflog0
# $ sudo ifconfig pflog0 destroy 
#block log (all, to pflog0) all

# Antispoof
antispoof log quick for $int_if

# spoofing check for illegitimate traffic
#vpnserver# block drop in log quick on $tun_if inet from { $int_if:network, ($int_if) } to any
#vpnserver# block drop in log quick on $tun_if inet6 from { <lan_inet6>, ($int_if) } to any

# Block to/from illegal destinations or sources
block drop in log quick from no-route to any
block drop in log quick from urpf-failed to any
#vpnserver# block drop in log quick on $int_if from urpf-failed to any
# This is observed on macOS
#block drop in log quick on $int_if from any to 255.255.255.255

# LAN services: block access, except from localnet
block in proto tcp from any to $int_if port $lan_tcp_services
block in proto udp from any to $int_if port $lan_udp_services

# Allow VPN connections to the VPN host:
# http://serverfault.com/questions/555594/troubleshoot-broken-tcp-from-openvpn-client-to-server-but-ping-traceroute-work
# This rule must be included below BEFORE these packets are passed by other rules:
#vpnserver# pass in quick on $tun_if reply-to $tun_if inet from $vpn_net to $int_if
#vpnserver# pass in quick on $tun_if reply-to $tun_if inet from $vpn_net to ($tun_if)
#vpnserver# pass quick on $tun_if inet from $int_if:network to $vpn_net
#vpnserver# pass out quick on $tun_if inet from ($tun_if) to $vpn_net keep state

# VPN clients: fully trusted, both directions required for forwarding to work
#vpnserver# pass quick on $tun_if inet from $vpn_net to any keep state
#vpnserver# pass quick on $tun_if inet6 from $vpn_net6 to any keep state

# VPN client connections
# redirect-gateway def1 (in the server's push config) means nearly all client traffic
# is now routed via the tun interface by the OS routing table — PF just needs to permit it
pass quick on $tun_if inet from any to any keep state
pass quick on $tun_if inet6 from any to any keep state

# LAN/local interface: outbound-only (public Wi-Fi hardening stays intact)
pass out quick on $int_if inet from ($int_if) to any keep state
pass out quick on $int_if inet6 from <lan_inet6> to any keep state

# Whitelist
pass in quick from <whitelist>
pass out quick to <whitelist>

# Block brute force attacks
block drop log quick from <bruteforce>

# Block HTTP floods
block drop quick proto tcp from <httpflood> to $int_if port http

# Allow application-specific traffic over these interfaces
# multicast DNS
pass on $int_if proto { tcp, udp } to { 224.0.0.2, 224.0.0.18, 224.0.0.251 } port mdns
pass on $int_if proto igmp to { 224.0.0.1, 224.0.0.22, 224.0.0.251 }

# quick pass of Tor relay ports to avoid blocks below
#tor_relay = "{ 9001, 9030 }"
#pass in proto tcp from any to $int_if port $tor_relay
#pass out proto tcp from $int_if port $tor_relay to any

# Open Source IP blocks
# Refresh with pfctl -a blockips -T load -f /opt/local/etc/macos-fortress/blockips.conf
anchor 'blockips' label "Open Source IP Blocks"
load anchor 'blockips' from '/opt/local/etc/macos-fortress/blockips.conf'

# ICMP
icmp_types = "echoreq"
pass out inet proto icmp from ($int_if) to any icmp-type $icmp_types
pass in inet proto icmp from any to $int_if icmp-type $icmp_types

# allow out the default range for traceroute(8):
# "base+nhops*nqueries-1" (33434+64*3-1)
pass out on $int_if inet proto udp from any to any port 33433 >< 33626

# Allow critical system traffic
pass in quick inet proto udp from port bootps to port bootpc
pass out quick inet proto udp from port bootpc to port bootps

# LAN services
#vpnserver# pass in quick inet proto tcp from { $vpn_net, $int_if:network } to $int_if port $lan_tcp_services
#vpnserver# pass in quick inet proto udp from { $vpn_net, $int_if:network } to $int_if port $lan_udp_services
#vpnserver# pass out quick proto tcp from $int_if port $lan_tcp_services to { $vpn_net, $int_if:network }
#vpnserver# pass out quick proto udp from $int_if port $lan_udp_services to { $vpn_net, $int_if:network }
pass in quick inet proto tcp from $int_if:network to $int_if port $lan_tcp_services
pass in quick inet proto udp from $int_if:network to $int_if port $lan_udp_services
pass out quick proto tcp from $int_if port $lan_tcp_services to $int_if:network
pass out quick proto udp from $int_if port $lan_udp_services to $int_if:network

# Internet services
## examples
# internet_udp_services = "{ https, 500, openvpn,	\
# 	1701, 4500, 5060, 5190, 5297, 5298, 5678, 49160:49163,	\
# 	16384:16403 }"
# internet_tcp_services = "{ www, https, 1640, 1723, 	\
# 	4190, 5060, 5190, 5218, 5220, 5222, 5223, 5269, 5298, 7777,	\
# 	8008, 8443, 8800, 8843, 9001, 9030, 49160:49163 }"
pass in inet proto tcp from any to $int_if port $internet_tcp_services
pass in inet proto udp from any to $int_if port $internet_udp_services
pass out inet proto tcp from $int_if to any port $internet_tcp_services
pass out inet proto udp from $int_if to any port $internet_udp_services

# ssh really restrictive
pass in inet proto tcp from any to $int_if port ssh	\
	keep state (max-src-conn 5, max-src-conn-rate 5/2,		\
	overload <bruteforce> flush global)
pass out inet proto tcp from $int_if port ssh

# web, mail, calendarservice, syncthing more restrictive
pass in inet proto tcp from any to $int_if	\
	port $mail_tcp_services \
	keep state (max-src-nodes 50, max-src-conn 200, max-src-conn-rate 100/10,	\
	overload <bruteforce> flush global)
pass out inet proto tcp from $int_if to any	\
	port $mail_tcp_services

# CalDAV/CardDAV + web ports based on observed scans
pass in log inet proto tcp from any to $int_if \
        port $calendar_web_tcp_services \
        keep state (max-src-nodes 100, max-src-conn 40, max-src-conn-rate 20/10, \
        overload <bruteforce> flush global)
pass out inet proto tcp from $int_if to any port $calendar_web_tcp_services

pass in inet proto { tcp, udp } from any to $int_if	\
	port $syncthing_service \
	keep state (max-src-nodes 50, max-src-conn 200, max-src-conn-rate 100/10,	\
	overload <bruteforce> flush global)
pass out inet proto { tcp, udp } from $int_if to any	\
	port $syncthing_service

# HTTP - CRL/cert distribution, internet-facing, rate-limited against abuse
pass in inet proto tcp from any to $int_if port http \
        keep state (max-src-conn 20, max-src-conn-rate 30/5, \
        overload <httpflood> flush global)
pass out inet proto tcp from $int_if port http

# I2P
# i2p_port = "26126"
# pass in inet proto { tcp, udp } from any to $int_if port $i2p_port
# pass out inet proto { tcp, udp } from $int_if port $i2p_port to any
