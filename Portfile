post-extract {
    reinplace "s|@PREFIX@|${prefix}|g" \
                    ${worksrcpath}/etc/nginx.conf.sample
}

proc pki_lockdown {path {is_private 0}} {
    if {[file isdirectory $path]} {
        if {[string match "*private*" [file tail $path]]} {
            set is_private 1
        }
        if {$is_private} {
            file attributes $path -permissions 0700
        } else {
            # allow other to view contents of non-private dirs
            file attributes $path -permissions 0755
        }
        foreach child [glob -nocomplain -directory $path *] {
            pki_lockdown $child $is_private
        }
    } else {
        if {$is_private} {
            if {[file extension $path] in {.sh .py}} {
                file attributes $path -permissions 0750
            } else {
                file attributes $path -permissions 0600
            }
        } else {
            if {[file extension $path] in {.sh .py}} {
                file attributes $path -permissions 0750
            } else {
                file attributes $path -permissions 0640
            }
        }
    }
}

set user_underscore_www         _www
set group_underscore_www        _www

if {![existsuser ${user_underscore_www}]} {
    set user_underscore_www     nobody
}
if {![existsgroup ${group_underscore_www}]} {
    set group_underscore_www    nobody
}

use_configure       no

build {}

set pki_share_dir   ${prefix}/share/pki-structure
set pki_etc_dir_str {${prefix}/etc/pki-structure}
set pki_etc_dir     [subst ${pki_etc_dir_str}]
set pki_log_dir_str {${prefix}/var/log/pki-structure}
set pki_log_dir     [subst ${pki_log_dir_str}]
set mdm_private_yaml    mdm-private/yaml

destroot {
    # reference in share, live deployment in etc
    xinstall -d ${destroot}${pki_share_dir}
    xinstall -d ${destroot}${pki_etc_dir}/${mdm_private_yaml}
    xinstall -d ${destroot}${prefix}/var/log/nginx

    # reference scripts and configurations in share
    system -W ${worksrcpath} \
        "${worksrcpath}/bin/replicate_pki_structure.sh \
            ${destroot}${pki_share_dir}"

    # nginx.conf template: same pattern, tracked under ${prefix}/etc
    xinstall -m 644 \
        ${worksrcpath}/etc/nginx.conf.sample \
        ${destroot}${prefix}/etc/nginx-pki.conf.macports

    xinstall -d ${destroot}${pki_log_dir}
}

# ensure that installed scripts are cwd-aware
post-destroot {
    foreach script [glob -nocomplain ${destroot}${pki_etc_dir}/bin/*.sh] {
        set base [file tail $script]
        if {$base eq "pki_common.sh" || $base eq "replicate_pki_structure.sh"} {
            continue
        }
        set fh [open $script r]
        set content [read $fh]
        close $fh
        if {![regexp {cd "\$\{SCRIPT_DIR\}/\.\."} $content] \
                && ![regexp {PKI_ROOT="\$\(cd "\$\{SCRIPT_DIR\}/\.\." && pwd\)"} $content]} {
            error "pki-structure: $base does not resolve PKI_ROOT relative to its own location - cwd-dependent script would break under a daemon"
        }
    }
}

# The deployment directory is where the user's actual PKI (keys, certs,
# index files) will be created - keep it even though destroot itself
# only populates it with the replicated scripts/configs
destroot.keepdirs-append ${destroot}${pki_etc_dir}
destroot.keepdirs-append ${destroot}${pki_etc_dir}/${mdm_private_yaml}
destroot.keepdirs-append ${destroot}${pki_log_dir}
destroot.keepdirs-append ${destroot}${prefix}/var/log/nginx

# A dedicated launchd job for the PKI's nginx instance, parallel to the
# nginx port's own startupitem but pointed at nginx-pki.conf and a
# separate pidfile, so it runs as an independent daemon alongside (not
# instead of) any other nginx configuration on this system.

# consistent with ${prefix}/etc/nginx-pki.conf
set nginx_pki_pidfile  ${prefix}/var/run/nginx/nginx-pki.pid

# Startup items: the nginx launcher (long-running foreground daemon)
# and the periodic CRL-refresh job (short-lived, no persistent pid)

startupitem.create  yes

startupitems \
    name            ${name}-crlupdate \
    init [list \
                    {set -e} \
                    "PKI_ROOT=\"${pki_etc_dir_str}\"" \
                    {DATE=(/bin/date "+%FT%T")} \
    ] \
    start [list \
                    {[ -f "${PKI_ROOT}/pki_identity.env" ] || { echo "pki_identity.env not found in ${PKI_ROOT}; skipping." ; exit 0 ; }} \
                    {. "${PKI_ROOT}/pki_identity.env"} \
                    {PKI_SITE_DIR="${prefix}/var/www/${PKI_FQDN}"} \
                    {/bin/mkdir -p "${PKI_SITE_DIR}"} \
                    {echo "CRL update started on $(${DATE[@]})…"} \
                    {for ca in root intermediate; do} \
                    "\t\"\${PKI_ROOT}/bin/create_crl.sh\" \"\$ca\" > /dev/null" \
                    "\tSRC=\"\${PKI_ROOT}/\$ca/certs/\$ca.cer\"" \
                    "\tDST=\"\${PKI_SITE_DIR}/\$ca.cer\"" \
                    "\tif \[ ! -f \"\$DST\" ] || \[ \"\$SRC\" -nt \"\$DST\" ]\; then" \
                    "\t\t/bin/cp -p \"\$SRC\" \"\${DST}.tmp\" && /bin/mv -f \"\${DST}.tmp\" \"\$DST\" && touch \"\$DST\"" \
                    "\t\tchmod 0644 \"\$DST\"" \
                    "\t\tchgrp ${group_underscore_www} \"\$DST\"" \
                    "\tfi" \
                    "\t/bin/cp -p \"\${PKI_ROOT}/\$ca/crl/\$ca.crl\" \"\${PKI_SITE_DIR}/\$ca.crl.tmp\" && /bin/mv -f \"\${PKI_SITE_DIR}/\$ca.crl.tmp\" \"\${PKI_SITE_DIR}/\$ca.crl\" && touch \"\${PKI_SITE_DIR}/\$ca.crl\"" \
                    "\tchmod 0644 \"\${PKI_SITE_DIR}/\$ca.crl\"" \
                    "\tchgrp ${group_underscore_www} \"\${PKI_SITE_DIR}/\$ca.crl\"" \
                    {done} \
                    {echo "CRL update completed on $(${DATE[@]})."} \
    ] \
    stop            "\"/usr/bin/kill -SIGUSR1 \\\"\$(/usr/bin/pgrep -u root ${name}-crlupdate.wrapper)\\\" 2>/dev/null\"" \
    pidfile         none

startupitems-append \
    name            ${name}-nginx \
    init            "pidfile=\"\${prefix}/var/run/nginx/nginx-pki.pid\"" \
    start [list     "\"\${prefix}/sbin/nginx\" \\" \
                    "\t-c \\" \
                    "\t\"\${prefix}/etc/nginx-pki.conf\" \\" \
                    "\t-g \"daemon off;\"" \
    ] \
    stop [list      "if \[ -f \"\${pidfile}\" \]; then" \
                    "\t/usr/bin/kill \"\$(cat \"\${pidfile}\")\" \\" \
                    "\t\t&& /bin/rm -f \"\${pidfile}\" ;" \
                    "else" \
                    "\t/usr/bin/kill -SIGUSR1 \"\$(/usr/bin/pgrep -u root nginx)\" 2>/dev/null ;" \
                    "fi" \
    ]

post-destroot {
    # org.macports.pki-structure-crlupdate
    reinplace -E \
        "1s|^(#!\[\[:space:]]*)/bin/sh|\\1/usr/bin/env bash|" \
        ${destroot}${prefix}/etc/${startupitem.location}/org.macports.${name}-crlupdate/${name}-crlupdate.wrapper

    reinplace \
        "s|^<key>ProgramArguments</key>|<key>EnvironmentVariables</key>\\
	<dict>\\
		<key>PATH</key>\\
		<string>${prefix}/bin:${prefix}/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>\\
	</dict>\\
	<key>WorkingDirectory</key>\\
	<string>${pki_etc_dir}</string>\\
	<key>StartCalendarInterval</key>\\
	<array>\\
		<dict>\\
			<key>Weekday</key>\\
			<integer>7</integer>\\
			<key>Hour</key>\\
			<integer>2</integer>\\
			<key>Minute</key>\\
			<integer>30</integer>\\
		</dict>\\
	</array>\\
	<key>StandardErrorPath</key>\\
	<string>${prefix}/var/log/${name}/crlupdate.log</string>\\
	<key>StandardOutPath</key>\\
	<string>${prefix}/var/log/${name}/crlupdate.log</string>\\
&|" \
        ${destroot}${prefix}/etc/${startupitem.location}/org.macports.${name}-crlupdate/org.macports.${name}-crlupdate.plist

    # org.macports.pki-structure-nginx
    reinplace -E \
        "1s|^(#!\[\[:space:]]*)/bin/sh|\\1/usr/bin/env bash|" \
        ${destroot}${prefix}/etc/${startupitem.location}/org.macports.${name}-nginx/${name}-nginx.wrapper

    reinplace \
        "s|^<key>ProgramArguments</key>|<key>EnvironmentVariables</key>\\
	<dict>\\
		<key>PATH</key>\\
		<string>${prefix}/bin:${prefix}/sbin:/usr/bin:/bin:/usr/sbin:/sbin</string>\\
	</dict>\\
	<key>StandardErrorPath</key>\\
	<string>${prefix}/var/log/${name}/${name}-nginx.log</string>\\
	<key>StandardOutPath</key>\\
	<string>${prefix}/var/log/${name}/${name}-nginx.log</string>\\
&|" \
        ${destroot}${prefix}/etc/${startupitem.location}/org.macports.${name}-nginx/org.macports.${name}-nginx.plist
}

post-activate {
    # deployed scripts and configurations in etc
    # existing files will not be overwritten without --overwrite flag    
    system -W ${pki_share_dir} \
        "${pki_share_dir}/bin/replicate_pki_structure.sh \
            ${pki_etc_dir}"

    # Personalized-file templates: always installed under a .macports
    # suffix in the tracked share dir, so upgrades keep them current.
    # The live, editable copies (pki_identity.env, create_organization_smime_pki.sh)
    # are seeded from these in post-activate, once, only if not already present
    foreach personalized [list \
        pki_identity.env \
        bin/create_organization_smime.sh \
        bin/create_organization_mdm.sh \
        etc/nginx.conf \
        etc/pf.conf \
        "${mdm_private_yaml}/ios-restrictions-baseline.yaml" \
        "${mdm_private_yaml}/ios-configurator-extras.yaml" \
        "${mdm_private_yaml}/myorganization-settings.yaml" \
        "${mdm_private_yaml}/myorganization-trust.yaml" \
        "${mdm_private_yaml}/persona-settings.yaml" \
    ] {
        regsub {\.sample$} $personalized "" personalized_nosample
        if {[file exists ${pki_etc_dir}/${personalized_nosample}.sample]} {
            file rename -force \
                ${pki_etc_dir}/${personalized_nosample}.sample \
                ${pki_etc_dir}/${personalized_nosample}.macports
        }
    }

    # Seed personalized files once, on the live filesystem, only if the user
    # doesn't already have one - never overwrite an existing deployment's
    # branding on upgrade.
    foreach personalized [list \
        pki_identity.env \
        bin/create_organization_smime.sh \
        bin/create_organization_mdm.sh \
        "${mdm_private_yaml}/ios-restrictions-baseline.yaml" \
    ] {
        if {![file exists ${pki_etc_dir}/${personalized}]} {
            ui_msg "--->  Seeding ${pki_etc_dir}/${personalized} from the baseline template"
            file copy -force \
                ${pki_etc_dir}/${personalized}.macports \
                ${pki_etc_dir}/${personalized}
        }
    }

    # Same pattern for the CRL-serving nginx-pki.conf, different directory
    if {![file exists ${prefix}/etc/nginx-pki.conf]} {
        ui_msg "--->  Seeding ${prefix}/etc/nginx-pki.conf from the baseline template"
        file copy -force \
            ${prefix}/etc/nginx-pki.conf.macports \
            ${prefix}/etc/nginx-pki.conf
    }

    pki_lockdown ${pki_etc_dir}
}

notes "
System-level PKI is installed in ${pki_etc_dir}, whose\
    permissions are only accessible through sudo. To create\
    a PKI structure integrated with AIA and CRL distribution:

    # define your PKI idendtity
    sudo vi ${pki_etc_dir}/pki_identity.env
    sudo bash -c 'cd ${pki_etc_dir} ; \\
        export CREATE_PKI_WITHIN_THIS_PKI_DIRECTORY=1 ; \\
        bin/create_root.sh && bin/create_intermediate.sh \\
        && bin/create_server.sh && bin/create_codesign.sh'

Content details:
    ${pki_share_dir}
        Pristine reference copy of the scripts and openssl configs.
        Replaced on every upgrade; do not edit in place.

    ${pki_etc_dir}
        Live PKI deployment. pki_identity.env, 
        create_organization_smime_pki.sh, and
        create_organization_mdm.sh are seeded here once and
        never overwritten. Edit pki_identity.env, then run the
        create_*.sh scripts from this directory.

    ${prefix}/etc/nginx-pki.conf
        Live nginx config, seeded once, not overwritten thereafter.

    Permissions: everything under ${pki_etc_dir} is mode 0750/0640
    (0700/0600 under any 'private' subdirectory). sudo is required
    to read or run anything here.

Destructive overwrite of ${pki_etc_dir}:
    sudo bash -c 'PKI_ASSUME_YES=1 \\
        ${pki_share_dir}/bin/replicate_pki_structure.sh \\
            --overwrite ${pki_etc_dir}'

Destructive clean of PKI:
    sudo bash -c 'PKI_ASSUME_YES=1 \\
        ${pki_etc_dir}/bin/clean_everything_and_create_pki.sh \\
            \[--create-pki]'

port load ${name} launches an nginx web server that listens\
    on port 80 in the CRL endpoint directory specified by\
    ${prefix}/etc/nginx-pki.conf. Internet access to this\
    endpoint is controlled by port forwarding on the router\
    and DNS settings to the PKI server's FQDN specified in\
    ${pki_etc_dir}/pki_identity.env. See port dns-server\
    to configure a split horizon DNS for the CRL endpoint\
    on the LAN.  A local server pf firewall configuration\
    example for internet accessible port 80 is provided in\
    ${pki_etc_dir}/etc/pf.conf. Port 80 on macOS systems may\
    also be bound by the native apachectl, and port ${name}'s\
    CRL service must be harmonized with any other local\
    services bound to port 80. If user enabled, the native\
    macOS Apache launch daemon will conflict on port 80 and\
    can be diabled via launchctl:

    sudo launchctl bootout system/org.apache.httpd
    sudo launchctl disable system/org.apache.httpd
    launchctl print-disabled system | grep httpd

Port 80 troubleshooting:

    sudo lsof -nP -iTCP:80 -sTCP:LISTEN | tail +2 | awk '{print \$2}' \\
        | xargs -I {} ps -p {} -o user=,pid=,command=
"
