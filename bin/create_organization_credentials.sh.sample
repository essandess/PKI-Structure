#!/usr/bin/env bash

# create_organization_credentials.sh

set -e
set -E
set -o pipefail
trap 'rc=$?; echo "Error: $(basename "$0") failed (exit ${rc}) at ${BASH_SOURCE[0]}:${LINENO}: ${BASH_COMMAND}" >&2' ERR
if [ "$#" -gt 0 ]; then
    echo "Error: $(basename "$0") takes no arguments (got $#)." >&2
    echo "Usage: $(basename "$0")" >&2
    exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PKI_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "${PKI_ROOT}" || exit

# Credentials creation

# CA certs
bin/create_credentials.sh --ca-certs-only

# Person A and B
bin/create_credentials.sh --with-privoxy --allow-expired-encryption --allow-superseded-encryption 'persona_{gmail,comcast}_*' 'personb_*_2026' --user-keychain

# KeePass item for credentials installer (example)
# bin/create_keepass_entry.sh --db /path/to/mykeepassdb.kdbx mdm/credentials/install_credentials_persona_LBgmailCcomcastRB_S_personb_S_2026.sh
# bin/create_keepass_entry.sh --xml-out ../install_credentials_persona_LBgmailCcomcastRB_S_personb_S_2026.xml mdm/credentials/install_credentials_persona_LBgmailCcomcastRB_S_personb_S_2026.sh
