proc is_private_path {path} {
    return [regexp {(?:private|key)} [file tail $path]]
}

proc pki_lockdown {path {is_private 0}} {
    if {[file isdirectory $path]} {
        if {[[is_private_path $path]]} {
            set is_private 1
        }
        if {$is_private} {
            file attributes $path -permissions 0700
        } else {
            # allow other to view contents of non-private dirs
            file attributes $path -permissions 0755
        }
        foreach child [glob -nocomplain -directory $path *] {
            pki_lockdown $child $is_private
        }
    } else {
        if {$is_private} {
            if {[file extension $path] in {.sh .py}} {
                file attributes $path -permissions 0750
            } else {
                file attributes $path -permissions 0600
            }
        } else {
            if {[file extension $path] in {.sh .py}} {
                file attributes $path -permissions 0750
            } else {
                file attributes $path -permissions 0640
            }
        }
    }
}

proc url_to_reverse_dns {url} {
    regexp {(?:[a-z]+://)?([^/:]+)(.*)} [string tolower $url] -> host path
    set parts [lreverse [split $host .]]
    # ignore trailing `.git` if the URL is a repo
    foreach seg [split [string map {.git ""} $path] /] {
        if {$seg ne ""} {lappend parts $seg}
    }
    join $parts .
}

set user_underscore_www         _www
set group_underscore_www        _www

if {![existsuser ${user_underscore_www}]} {
    set user_underscore_www     nobody
}
if {![existsgroup ${group_underscore_www}]} {
    set group_underscore_www    nobody
}

post-patch {
    foreach pyfile {configurate_yaml.py pki_keychain.py pki_validate.py}  {
        reinplace -W ${worksrcpath} \
                    "s|^#!/usr/bin/env python3|#!${python_bin}|" \
                    bin/${pyfile}
    }

    reinplace -W ${worksrcpath} \
                    "s|^PYTHON_DEFAULT=\"python3\"|PYTHON_DEFAULT=\"${python_bin_name}\"|" \
                    bin/define_python.sh

    foreach script \
        {bin/pki_keychain.py bin/create_keepass_entry.sh test/pki_test.sh}  {
        reinplace -W ${worksrcpath} \
                    "s|[url_to_reverse_dns ${github.homepage}]|org.macports.${name}|g" \
                    ${script}
    }
}

post-patch {
    reinplace "s|@PREFIX@|${prefix}|g" \
                    ${worksrcpath}/etc/nginx.conf.sample
}

