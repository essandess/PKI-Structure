# openssl_intermediate.cnf -- configuration of the INTERMEDIATE CA.
#
# Used by
#   bin/create_intermediate.sh  req (the subject of the intermediate's CSR)
#   bin/create_crl.sh intermediate, bin/revoke_certificate.sh intermediate,
#   bin/updatedb_and_delete_expired_certs.sh
#   bin/create_server.sh, bin/create_codesign.sh  ca -revoke, through
#                               pki_revoke_matching_cn
# The intermediate's own certificate is issued by the ROOT, with the
# intermediate_ca section of ../openssl.cnf. Certificates this CA issues use
# the configuration of what they are (server/, codesign/, smime/), which
# point at this CA's database.

.include ./common_policy.cnf

[ca]
default_ca                      = CA_default

[ CA_default ]
dir                             = intermediate
new_certs_dir                   = $dir/newcerts
database                        = $dir/index.txt
private_key                     = $dir/private/intermediate.key.pem
certificate                     = $dir/certs/intermediate.cert.pem

# For certificate revocation lists.
crlnumber                       = $dir/crlnumber
crl_extensions                  = crl_ext
default_crl_days                = 30

# SHA-1 is deprecated, so use SHA-2 instead.
default_md                      = sha256

name_opt                        = ca_default
cert_opt                        = ca_default
preserve                        = no
policy                          = policy_loose

# allow issuing multiple certificates with the same CN
unique_subject                  = no

[req]
# Options for the `req` tool (`man req`).
distinguished_name              = req_distinguished_name
string_mask                     = utf8only

[ req_distinguished_name ]
# See <https://en.wikipedia.org/wiki/Certificate_signing_request>.
countryName                     = $ENV::ORG_COUNTRY
stateOrProvinceName             = $ENV::ORG_STATE
localityName                    = $ENV::ORG_LOCALITY
organizationName                = $ENV::ORG_NAME
organizationalUnitName          = $ENV::ORG_NAME Intermediate Certification Authority
commonName                      = $ENV::ORG_NAME Intermediate CA

# Optionally, specify some defaults.
countryName_default             = $ENV::ORG_COUNTRY
stateOrProvinceName_default     = $ENV::ORG_STATE
localityName_default            = $ENV::ORG_LOCALITY
organizationName_default        = $ENV::ORG_NAME
organizationalUnitName_default  = $ENV::ORG_NAME Intermediate Certification Authority
commonName_default              = $ENV::ORG_NAME Intermediate CA

# replicates ../openssl.cnf intermediate_ca extension
[ intermediate_ca ]
# The intermediate certificate, issued by the root.
subjectKeyIdentifier            = hash
authorityKeyIdentifier          = keyid:always
basicConstraints                = critical, CA:true, pathlen:0
keyUsage                        = critical, cRLSign, keyCertSign
crlDistributionPoints           = URI:http://$ENV::PKI_FQDN/root.crl
authorityInfoAccess             = caIssuers;URI:http://$ENV::PKI_FQDN/root.cer

[ crl_ext ]
# Extension for CRLs (`man x509v3_config`).
authorityKeyIdentifier          = keyid:always
