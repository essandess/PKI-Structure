# ios-restrictions-baseline.yaml
#
# Optional baseline for the Restrictions payload
# (com.apple.applicationaccess). Include from a profile YAML
# with `include:`. Contains no secrets.
#
# Scope: keys that are current (not deprecated) and work on
# unsupervised, MDM-enrolled devices, per Apple's
# device-management key reference and Apple Configurator
# 2.20. Supervised-only and deprecated keys are excluded;
# Apple Configurator still lists several of them.
#
# Values are Apple's documented defaults. Including this file
# pins them explicitly; omit `include:` to leave them unset.
# Profile YAML settings override this file.
#
# Keys are Apple's names, passed through unchanged.

payloads:
  - id: restrictions
    type: com.apple.applicationaccess
    settings:
      # allow* (default true)
      allowAutoDim: true
      allowDefaultBrowserModification: true
      allowDefaultCallingAppModification: true
      allowDefaultMessagingAppModification: true
      allowEnterpriseAppTrust: true
      allowEnterpriseBookBackup: true
      allowEnterpriseBookMetadataSync: true
      allowLockScreenControlCenter: true
      allowLockScreenNotificationsView: true
      allowLockScreenTodayView: true
      allowManagedAppsCloudSync: true
      allowOTAPKIUpdates: true
      allowOpenFromManagedToUnmanaged: true
      allowOpenFromUnmanagedToManaged: true
      allowPassbookWhileLocked: true
      allowRemoteScreenObservation: true
      allowSatelliteConnection: true
      allowScreenShot: true
      allowUSBRestrictedMode: true
      allowUntrustedTLSPrompt: true
      allowWebDistributionAppInstallation: true
      allowiPhoneMirroring: true

      # force* (default false)
      forceAirDropUnmanaged: false
      forceAirPlayOutgoingRequestsPairingPassword: false
      forceEncryptedBackup: false

      # content ratings and Safari
      ratingApps: 1000
      ratingRegion: us
      safariAllowJavaScript: true
      safariForceFraudWarning: false
