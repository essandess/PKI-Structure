# Settings for iOS: passcode, Wi-Fi, restrictions.
#
# Converter fills in: PayloadType, PayloadVersion, PayloadUUIDs,
# payload identifiers (<profile identifier>.<id>), PayloadEnabled.
#
# CONTAINS SECRETS (Wi-Fi password). Keep under mdm-private/, mode
# 0600. Signing does not encrypt the password in the .mobileconfig.

# ---- Profile ----------------------------------------------------
# identifier: org.myorganization.mdm.myorganization-settings
#   Optional. Default: <DOMAIN_NAME from pki_identity.env,
#   reversed>.mdm.<file name>. Keep stable once deployed; devices
#   match profiles on it.
name: Settings for iOS
description: >-
  Passcode, Wi-Fi and restriction policy for MyOrganization
  devices.
organization: ${ORG_NAME}   # from pki_identity.env
scope: System                # System (default) or User
removal_disallowed: false    # PayloadRemovalDisallowed

# Layers merged under this file, in order; this file wins.
# Paths relative to this file. Included files: `payloads:` only.
include:
  - ios-restrictions-baseline.yaml   # delete to skip defaults

# ---- Payloads -----------------------------------------------------
# id           Required. Stable slug, unique in the profile.
#              Identifier: <profile identifier>.<id>; UUID derived
#              from it. Merge key for `include:`. Do not rename.
# type         Required. Apple payload type, verbatim.
# name         Optional. PayloadDisplayName (default: id).
# description  Optional. PayloadDescription.
# settings     Apple's own keys, passed through unchanged. Keys
#              starting with "Payload" are reserved. Quote values
#              YAML would read as numbers/booleans ("12345678",
#              "yes").
payloads:

  - id: passcode
    type: com.apple.mobiledevice.passwordpolicy
    name: Passcode
    description: Configures passcode settings
    settings:
      forcePIN: true
      allowSimple: true
      minLength: 7
      requireAlphanumeric: false
      maxFailedAttempts: 10
      maxInactivity: 2

  - id: wifi-myssid
    type: com.apple.wifi.managed
    name: WiFi (My SSID WiFi Name)
    settings:
      SSID_STR: My SSID WiFi Name
      Password: "CHANGE-ME"   # secret
      EncryptionType: WPA
      AutoJoin: true
      HIDDEN_NETWORK: false
      CaptiveBypass: false
      IsHotspot: false
      ProxyType: Auto
      ProxyPACURL: http://proxy.myorganization.private/proxy.pac
      ProxyPACFallbackAllowed: true
      # Omitted (Profile Manager defaults): AuthenticationMethod
      # "", Interface BuiltInWireless, SetupModes [], PayloadEnabled.

  # Only departures from Apple's defaults; defaults come from the
  # baseline file above, merged key by key.
  - id: restrictions
    type: com.apple.applicationaccess
    name: Restrictions
    settings:
      # Privacy
      allowApplePersonalizedAdvertising: false
      forceLimitAdTracking: true
      allowDiagnosticSubmission: false
      allowDiagnosticSubmissionModification: false
      # Managed/unmanaged contact separation
      allowManagedToWriteUnmanagedContacts: false
      allowUnmanagedToReadManagedContacts: false
      # Apple Watch
      forceWatchWristDetection: true
