# openssl.cnf -- configuration of the ROOT CA.
#
# Used by
#   bin/create_root.sh          req -x509 ... -extensions root_ca
#   bin/create_intermediate.sh  ca ... -extensions intermediate_ca
#                               (the root signs the intermediate)
#   bin/create_crl.sh root, bin/revoke_certificate.sh root,
#   bin/updatedb_and_delete_expired_certs.sh
#
# Extension sections are named for the certificate they are issued to; the
# scripts choose one with -extensions. Validity periods are not set here:
# each create_*.sh script owns its DAYS.

.include ./common_policy.cnf

[ca]
default_ca                      = CA_default

[ CA_default ]
dir                             = root
new_certs_dir                   = $dir/newcerts
serial                          = $dir/serial
database                        = $dir/index.txt
private_key                     = $dir/private/$dir.key.pem
certificate                     = $dir/certs/$dir.cert.pem

# The root only revokes intermediates, so its CRL can last a year and the
# root key can stay offline. Run bin/create_crl.sh root (and
# bin/publish_crls.sh --no-regenerate root) before it expires.
crlnumber                       = $dir/crlnumber
crl_extensions                  = crl_ext
default_crl_days                = 365

# SHA-1 is deprecated, so use SHA-2 instead.
default_md                      = sha256

name_opt                        = ca_default
cert_opt                        = ca_default
preserve                        = no
# set to policy_loose if state name/abbreviation mismatch on existing CA
policy                          = policy_strict

# allow issuing multiple certificates with the same CN
unique_subject                  = no

[req]
# Options for the `req` tool (`man req`).
distinguished_name              = req_distinguished_name
string_mask                     = utf8only

[ req_distinguished_name ]
# See <https://en.wikipedia.org/wiki/Certificate_signing_request>.
countryName                     = $ENV::ORG_COUNTRY
stateOrProvinceName             = $ENV::ORG_STATE
localityName                    = $ENV::ORG_LOCALITY
organizationName                = $ENV::ORG_NAME
organizationalUnitName          = $ENV::ORG_NAME Certification Authority
commonName                      = $ENV::ORG_NAME Root CA

# Optionally, specify some defaults.
countryName_default             = $ENV::ORG_COUNTRY
stateOrProvinceName_default     = $ENV::ORG_STATE
localityName_default            = $ENV::ORG_LOCALITY
organizationName_default        = $ENV::ORG_NAME
organizationalUnitName_default  = $ENV::ORG_NAME Certification Authority
commonName_default              = $ENV::ORG_NAME Root CA

[ root_ca ]
# The self-signed root certificate (`man x509v3_config`).
subjectKeyIdentifier            = hash
authorityKeyIdentifier          = keyid:always
basicConstraints                = critical, CA:true, pathlen:1
keyUsage                        = critical, cRLSign, keyCertSign

[ intermediate_ca ]
# The intermediate certificate, issued by the root.
subjectKeyIdentifier            = hash
authorityKeyIdentifier          = keyid:always
basicConstraints                = critical, CA:true, pathlen:0
keyUsage                        = critical, cRLSign, keyCertSign
crlDistributionPoints           = URI:http://$ENV::PKI_FQDN/root.crl
authorityInfoAccess             = caIssuers;URI:http://$ENV::PKI_FQDN/root.cer

[ crl_ext ]
# Extension for CRLs (`man x509v3_config`).
authorityKeyIdentifier          = keyid:always
