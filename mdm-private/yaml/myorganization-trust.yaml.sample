# Trust Profile for MyOrganization.
# Converter fills in: PayloadType, PayloadVersion, UUIDs, payload
# identifiers, payload types (root vs pkcs1), payload descriptions,
# display names (from each cert's CN), and base64 <data> blobs.

identifier: org.myorganization.mdm.myorganization-trust
name: Trust Profile for MyOrganization
description: >-
  Configures your device to trust the Profile Manager server
  MyOrganization.
scope: System   # System (default) or User

# Directories searched, in order, for each certificate below.
cert_dirs:
  - $PKI_ROOT/root/certs
  - $PKI_ROOT/intermediate/certs
  - $PKI_ROOT/server/certs
  - $PKI_ROOT/privoxy/certs
  - certs

# Order here is the PayloadContent order. DER or PEM.
certificates:
  - root.cer
  - intermediate.cer
  - privoxy.cer
