# Source description: network accounts and S/MIME identities for one person.
#
# The converter supplies PayloadType, PayloadVersion, PayloadUUIDs,
# payload identifiers and PayloadEnabled defaults. 'accounts:' entries map
# to Apple payloads via the AccountType classes in bin/configurate_yaml.py.
#
# Identifiers:
#   accounts/payloads  <profile identifier>.<id>
#   identities         <profile identifier>.pkcs12.<UUID>
#
# No secrets in this file: '!secret LABEL' is prompted for at build time.
# The profile holds them in plain text and is stored only in the PKI
# keychain (bin/pki_keychain.py profile-get extracts it).

name: Settings for User A Long Name
description: Network accounts and S/MIME identities for User A Long Name.
organization: ${ORG_NAME}        # from pki_identity.env
scope: User                      # User or System
removal_disallowed: false        # PayloadRemovalDisallowed

# Default mail sender name (EmailAccountName). Per-account 'account_name:'
# overrides.
short_name: User A Short Name

# ---- S/MIME identities ----------------------------------------------------
# Each name resolves to <name>-signature.p12 and <name>-encryption.p12 in
# identity_dirs. Fallback '<stem>.*<suffix>' also matches renamed files,
# e.g. <name>-signature.<sha1>.p12.
#
# Each .p12 opens with its keychain password (bin/pki_keychain.py).
# identity_dirs:                   # optional; default shown
#   - $PKI_ROOT/smime/private

identities:
  - persona_gmail_2026
  - persona_icloud_2026
  - persona_school_2026
  - persona_myorganization_2026
  # A prior identity, kept to decrypt old mail:
  # - old: persona_gmail_2022
  #   encryption_only: true
  #   allow_expired_encryption: true
  #   allow_superseded_encryption: true
  #   allow_signature_with_encryption: true   # extra identity_dirs tree only

# ---- Network accounts -----------------------------------------------------
# type         Required: mail, caldav or carddav.
# id           Optional stable slug; default <type>-<slug of description>.
#              Merge key for 'payloads:' overrides. Do not rename after
#              deployment.
# description  Required. Account display label. Default PayloadDisplayName:
#                mail:    <description>
#                caldav:  "Calendar (<description>)"
#                carddav: "Contacts"
#              Override with 'name:'.
# settings     Optional. Apple key names, deep-merged last
#              (e.g. PreventMove).
accounts:

  - type: mail
    description: MyOrganization
    email: persona@myorganization.org
    username: persona
    password: !secret mail-persona
    # Used for incoming and outgoing unless incoming_host/outgoing_host set.
    host: server.myorganization.org
    imap_port: 993                   # optional; default shown
    smtp_port: 587                   # optional; default shown
    # account_name: username         # default: short_name, then description
    # use_ssl: true                  # optional; both directions
    # outgoing_username: persona     # default: username
    # outgoing_password: !secret LABEL   # default: incoming password
    smime:
      identity: persona_myorganization_2026   # must be in 'identities:'
      encrypt_by_default: false      # also sets SMIMEEncryptionEnabled
      # sign: true                   # optional; default shown
      # allow_per_message_toggle: true    # optional; default shown
      # signing_overrideable: true        # optional; default shown
      # encrypt_overrideable: true        # optional; default shown

  - type: caldav
    description: MyOrganization
    host: server.myorganization.org
    port: 8443                       # optional; default shown
    username: persona
    password: !secret caldav-persona
    # principal_url: ""              # optional; default shown
    # use_ssl: true                  # optional; default shown

  - type: carddav
    description: Contacts
    host: server.myorganization.org
    port: 8843                       # optional; default shown
    principal_url: /addressbooks/__uids__/15309EE6-0DA4-4768-8FAE-B20C274C49C7
    username: persona
    password: !secret carddav-persona
    # use_ssl: true                  # optional; default shown
